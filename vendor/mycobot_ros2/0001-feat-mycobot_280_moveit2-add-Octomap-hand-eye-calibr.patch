+        "monitor_dynamics": False,
+        # Octomap: D435 포인트클라우드를 콜리전 오브젝트로 등록하기 위한 설정.
+        # sensors_3d.yaml의 sensor_plugin 설정만으로는 부족하고, 이 두 값을
+        # move_group에 별도로 넘겨줘야 PlanningSceneMonitor가 octomap을 생성함.
+        "octomap_frame": "g_base",
