+        # LaunchDescription이라 최상위 인자 목록에 안 잡힌다. 그래서 명령줄에
+        # use_rviz:=false를 주면 "Parameter 'use_rviz' is not supported" 경고만 뜨고
+        # RViz가 그대로 떴다(실제로 확인함). 여기서 같은 이름으로 한 번 더 선언해
+        # 두면 CLI 값이 컨텍스트에 먼저 들어가고, 안쪽 DeclareLaunchArgument는 이미
+        # 설정된 값을 덮어쓰지 않으므로 의도대로 동작한다.
+        #
+        # 쓰임새: rosbag 재생 확인처럼 MoveIt 기본 RViz 대신 전용 설정
+        # (src/mycobot_280_pick/config/scene_replay.rviz)을 띄우고 싶을 때, 창이
+        # 두 개 뜨는 걸 막는다.
+        DeclareLaunchArgument(
+            "enable_camera",
+            default_value="true",
+            description=(
+                "false면 realsense2_camera를 띄우지 않음 — rosbag 재생 세션처럼 "
+                "카메라 토픽을 bag이 공급하는 경우(발행자 이중화 방지) 또는 "
+                "D435가 아예 없는 장비에서 사용."
+            ),
+        ),
+        DeclareLaunchArgument(
+            "enable_pointcloud_filter",
+            default_value="true",
+            description=(
+                "false면 pointcloud_tomato_filter_node를 띄우지 않음(octomap 본체는 "
+                "유지) — 재생 세션에서 restamp_now:=true로 직접 띄울 때 중복 방지."
+            ),
+        ),
+        DeclareLaunchArgument(
+            "use_rviz",
+            default_value="true",
+            description=(
+                "false면 MoveIt 기본 RViz를 띄우지 않음 — 별도 RViz 설정을 직접 "
+                "띄울 때 창 중복을 피하려는 용도."
+            ),
+        ),
+        OpaqueFunction(function=_launch_setup),
+    ])
