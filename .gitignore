# colcon build artifacts
build/
install/
log/

# nested git repos (each has its own history, tracked separately)
src/mycobot_ros2/
src/easy_handeye2/
src/pymoveit2/

# python
__pycache__/
*.pyc
.pytest_cache/

# transient debugging output (tf2_tools view_frames, run logs)
frames_*.gv
frames_*.pdf
*.log

# rosbag — 용량이 크다(장면 bag 143MB/30초, 스윕 bag 240MB). 다만 검출 결과
# JSON/CSV는 오프라인 스윕의 입력이라 저장소에 남긴다(수 KB).
bags/*
!bags/*.json
!bags/*.csv

# 화면 녹화 영상. 리포트용 산출물이라 재생성 가능하고 용량이 크다.
# 주의: mp4는 ffmpeg을 q 없이 강제 종료하면 moov atom이 안 써져 통째로 못 쓴다.
# 녹화 시 `-movflags +frag_keyframe+empty_moov`를 붙일 것(실측 검증함).
*.mp4
*.mkv
